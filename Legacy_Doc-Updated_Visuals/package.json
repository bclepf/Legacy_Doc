{
  "name": "legacy-doc",
  "displayName": "Legacy Doc",
  "description": "Documentação automática multi-linguagem com orquestração multi-agente.",
  "version": "0.0.1",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "legacydoc.login",
        "title": "Legacy Doc: Entrar com E-mail e Senha",
        "icon": "$(sign-in)"
      },
      {
        "command": "legacydoc.register",
        "title": "Legacy Doc: Criar Nova Conta",
        "icon": "$(person-add)"
      },
      {
        "command": "legacydoc.resetPassword",
        "title": "Legacy Doc: Esqueci Minha Senha",
        "icon": "$(unlock)"
      },
      {
        "command": "legacydoc.addContext",
        "title": "Legacy Doc: Adicionar Arquivo de Contexto (.md)",
        "icon": "$(note)"
      },
      {
        "command": "legacydoc.removeContext",
        "title": "Legacy Doc: Remover Contexto do Projeto",
        "icon": "$(close-all)"
      },
      {
        "command": "legacydoc.listDocuments",
        "title": "Legacy Doc: Minhas Documentações Geradas",
        "icon": "$(history)"
      },
      {
        "command": "legacydoc.refreshUsage",
        "title": "Legacy Doc: Atualizar Saldo de Créditos",
        "icon": "$(refresh)"
      },
      {
        "command": "legacydoc.logout",
        "title": "Legacy Doc: Sair (Logout)",
        "icon": "$(sign-out)"
      },
      {
        "command": "legacydoc.generateMarkdown",
        "title": "Legacy Doc: Gerar Documentação (.md)",
        "icon": "$(markdown)"
      },
      {
        "command": "legacydoc.generatePdf",
        "title": "Legacy Doc: Gerar Documentação (.pdf)",
        "icon": "$(file-pdf)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "legacydoc-sidebar",
          "title": "Legacy Doc",
          "icon": "media/logo.png"
        }
      ]
    },
    "views": {
      "legacydoc-sidebar": [
        {
          "id": "legacydoc.usageView",
          "name": "Consumo de Créditos",
          "type": "webview",
          "when": "legacydoc.isAuthenticated"
        },
        {
          "id": "legacydoc.welcomeView",
          "name": "Gerador de Documentação"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "legacydoc.welcomeView",
        "contents": "⚡ Legacy Doc\n\nIA para Sistemas Legados\n\nTransforme código legado em documentação inteligente de forma rápida e organizada.\n\n[$(person-add) Criar Conta](command:legacydoc.register)\n\n[$(key) Entrar](command:legacydoc.login)\n\n[$(unlock) Recuperar Senha](command:legacydoc.resetPassword)\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n✨ Recursos Disponíveis\n\n✅ Documentação Automática\n\n✅ Análise Arquitetural\n\n✅ Auditoria de Código\n\n✅ Exportação Markdown\n\n✅ Exportação PDF\n\n✅ Contexto Personalizado por Projeto",
        "when": "!legacydoc.isAuthenticated"
      },
      {
        "view": "legacydoc.welcomeView",
        "contents": "✅ Login realizado com sucesso.\n\n⚠️ Nenhum repositório Git encontrado.\n\nAbra um projeto existente ou execute `git init` para habilitar a documentação.\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n📚 Histórico e Conta\n\n[$(history) Minhas Documentações Geradas](command:legacydoc.listDocuments)\n\n[$(sign-out) Sair (Logout)](command:legacydoc.logout)",
        "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount == 0"

      },
      {
        "view": "legacydoc.welcomeView",
        "contents": "📁 Projeto Detectado\n\n✅ Seu repositório está pronto para análise.\n\n🚀 Geração de Documentação\n\n[$(markdown) Gerar Documentação Markdown](command:legacydoc.generateMarkdown)\n\n[$(file-pdf) Gerar Documentação PDF](command:legacydoc.generatePdf)\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n📄 Contexto do Projeto\n\n[$(note) Adicionar Contexto](command:legacydoc.addContext)\n\n[$(close-all) Remover Contexto Atual](command:legacydoc.removeContext)\n\n━━━━━━━━━━━━━━━━━━━━━━━\n\n📚 Histórico e Conta\n\n[$(history) Minhas Documentações Geradas](command:legacydoc.listDocuments)\n\n[$(sign-out) Sair (Logout)](command:legacydoc.logout)",
        "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "legacydoc.login",
          "when": "!legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.register",
          "when": "!legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.resetPassword",
          "when": "!legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.addContext",
          "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
        },
        {
          "command": "legacydoc.removeContext",
          "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
        },
        {
          "command": "legacydoc.listDocuments",
          "when": "legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.refreshUsage",
          "when": "legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.logout",
          "when": "legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.generateMarkdown",
          "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
        },
        {
          "command": "legacydoc.generatePdf",
          "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "legacydoc.refreshUsage",
          "when": "view == legacydoc.usageView && legacydoc.isAuthenticated",
          "group": "navigation@1"
        },
        {
          "command": "legacydoc.generateMarkdown",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated && gitOpenRepositoryCount > 0",
          "group": "navigation@1"
        },
        {
          "command": "legacydoc.generatePdf",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated && gitOpenRepositoryCount > 0",
          "group": "navigation@2"
        },
        {
          "command": "legacydoc.listDocuments",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated",
          "group": "navigation@3"
        },
        {
          "command": "legacydoc.logout",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated",
          "group": "navigation@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/pdfkit": "^0.17.7",
    "@types/vscode": "^1.136.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "pdfkit": "^0.20.2"
  }
}
