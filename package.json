{
  "name": "legacy-doc",
  "displayName": "Legacy Doc",
  "description": "Documentação automática multi-linguagem com orquestração multi-agente.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "legacydoc.login",
        "title": "Legacy Doc: Login / API Key",
        "icon": "$(key)"
      },
      {
        "command": "legacydoc.register",
        "title": "Legacy Doc: Criar Nova Conta",
        "icon": "$(person-add)"
      },
      {
        "command": "legacydoc.resetPassword",
        "title": "Legacy Doc: Esqueci Minha Senha",
        "icon": "$(unlock)"
      },
      {
        "command": "legacydoc.listDocuments",
        "title": "Legacy Doc: Minhas Documentações Geradas",
        "icon": "$(history)"
      },
      {
        "command": "legacydoc.logout",
        "title": "Legacy Doc: Sair (Logout)",
        "icon": "$(sign-out)"
      },
      {
        "command": "legacydoc.generateMarkdown",
        "title": "Legacy Doc: Gerar Documentação (.md)",
        "icon": "$(markdown)"
      },
      {
        "command": "legacydoc.generatePdf",
        "title": "Legacy Doc: Gerar Documentação (.pdf)",
        "icon": "$(file-pdf)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "legacydoc-sidebar",
          "title": "Legacy Doc",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "legacydoc-sidebar": [
        {
          "id": "legacydoc.welcomeView",
          "name": "Gerador de Documentação"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "legacydoc.welcomeView",
        "contents": "Bem-vindo ao Legacy Doc!\n\nAutentique-se com sua conta ou crie um cadastro para liberar as ferramentas de análise.\n[$(key) Login / API Key](command:legacydoc.login)\n[$(person-add) Criar Nova Conta](command:legacydoc.register)\n[$(unlock) Esqueci Minha Senha](command:legacydoc.resetPassword)",
        "when": "!legacydoc.isAuthenticated"
      },
      {
        "view": "legacydoc.welcomeView",
        "contents": "A pasta atual não possui um repositório Git inicializado.\n\nInicie um repositório Git (`git init`) ou abra um projeto versionado para habilitar a análise.\n\n---\nHistórico e Conta:\n[$(history) Minhas Documentações Geradas](command:legacydoc.listDocuments)\n[$(sign-out) Sair (Logout)](command:legacydoc.logout)",
        "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount == 0"
      },
      {
        "view": "legacydoc.welcomeView",
        "contents": "Repositório Git detectado! Escolha o formato para documentar seu código:\n[$(markdown) Gerar Documentação (.md)](command:legacydoc.generateMarkdown)\n[$(file-pdf) Gerar Documentação (.pdf)](command:legacydoc.generatePdf)\n\n---\nHistórico e Sessão:\n[$(history) Minhas Documentações Geradas](command:legacydoc.listDocuments)\n[$(sign-out) Sair (Logout)](command:legacydoc.logout)",
        "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "legacydoc.login",
          "when": "!legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.register",
          "when": "!legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.resetPassword",
          "when": "!legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.listDocuments",
          "when": "legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.logout",
          "when": "legacydoc.isAuthenticated"
        },
        {
          "command": "legacydoc.generateMarkdown",
          "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
        },
        {
          "command": "legacydoc.generatePdf",
          "when": "legacydoc.isAuthenticated && gitOpenRepositoryCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "legacydoc.generateMarkdown",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated && gitOpenRepositoryCount > 0",
          "group": "navigation@1"
        },
        {
          "command": "legacydoc.generatePdf",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated && gitOpenRepositoryCount > 0",
          "group": "navigation@2"
        },
        {
          "command": "legacydoc.listDocuments",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated",
          "group": "navigation@3"
        },
        {
          "command": "legacydoc.logout",
          "when": "view == legacydoc.welcomeView && legacydoc.isAuthenticated",
          "group": "navigation@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.136.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  }
}